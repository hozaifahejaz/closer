{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "closer",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Accounts, couple links and saved answers (schema in migrations/).
  "d1_databases": [{ "binding": "DB", "database_name": "closer", "database_id": "580ea20e-6ae1-436d-836a-a34f9a7358e0", "migrations_dir": "migrations" }],
  // Limits on sign-up/log-in/partner-code tries, new guest rooms and room-code lookups (see tooMany in worker/index.js).
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ROOM_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "ROOM_LOOKUP_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Settings for preview builds of pull requests. Previews don't inherit bindings and
  // get no database, so accounts are off there (guest rooms work).
  "previews": {
    "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
    "ratelimits": [
      { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
      { "name": "ROOM_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
      { "name": "ROOM_LOOKUP_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
    ]
  }
}
